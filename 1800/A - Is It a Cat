#include <bits/stdc++.h>
using namespace std;
 
int main() {
    ios::sync_with_stdio(0);
    cin.tie(0);
    
    int t;
    cin >> t;
    while (t--) {
        int n;
        string s;
        cin >> n ;
        cin >> s;
        for (char &c : s)
            c = tolower(c);
        string x;
        for (char c : s) {
            if (x.empty() || x.back() != c)
                x += c;
        }
        if (x == "meow")
            cout << "YES
";
        else
            cout << "NO
";
    }
}