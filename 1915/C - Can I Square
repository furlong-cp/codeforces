#include <bits/stdc++.h>
using namespace std;
 
int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
 
    int t; // Number of test cases
    cin >> t;
 
    while (t--) {
 
        int n; // Number of buckets
        cin >> n;
 
        vector<int> v(n); // Stores the number of squares in each bucket
 
        // Input the number of squares in each bucket
        for (int i = 0; i < n; i++) {
            cin >> v[i];
        }
 
        // Find the total number of 1x1 squares
        // long long is needed because the sum can be as large as 2 * 10^14
        long long total = 0;
 
        for (int i = 0; i < n; i++) {
            total += v[i];
        }
 
        // To build a square using all the 1x1 squares,
        // the total number of squares must be a perfect square.
        //
        // For example:
        // 9  -> 3 * 3 -> YES
        // 16 -> 4 * 4 -> YES
        // 14 -> no integer x such that x * x = 14 -> NO
 
        // Find the integer square root of total
        long long root = sqrt(total);
 
        // Check whether root * root is exactly equal to total
        if (root * root == total) {
            cout << "YES
";
        }
        else {
            cout << "NO
";
        }
    }
 
    return 0;
}