#include <bits/stdc++.h>
using namespace std;
 
int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
 
    int t;
    cin >> t;
 
    while (t--) {
 
        int n;
        cin >> n;
 
        // Calculate total number of 1x1 squares
        long long total = 0;
 
        for (int i = 0; i < n; i++) {
            long long x;
            cin >> x;
            total += x;
        }
 
        // Binary search for x such that x * x = total
        long long low = 1;
        long long high = total;
 
        bool found = false;
 
        while (low <= high) {
 
            // Find middle
            long long mid = low + (high - low) / 2;
 
            // Check if mid * mid == total
            // We use division instead of multiplication
            // to avoid integer overflow.
            if (mid == total / mid && total % mid == 0) {
                found = true;
                break;
            }
 
            // Check if mid * mid < total
            // Instead of mid * mid, use mid < total / mid
            else if (mid < total / mid) {
                low = mid + 1;
            }
 
            // Otherwise mid * mid > total
            else {
                high = mid - 1;
            }
        }
 
        if (found) {
            cout << "YES
";
        }
        else {
            cout << "NO
";
        }
    }
 
    return 0;
}